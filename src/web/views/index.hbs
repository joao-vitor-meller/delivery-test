<html lang='pt-BR'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{{title}}</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap'
      rel='stylesheet'
    />
    <style>
      :root {
        --radius: 0.75rem;
        --background: oklch(0.977 0.014 78);
        --foreground: oklch(0.28 0.045 45);
        --card: oklch(1 0 0);
        --card-foreground: oklch(0.28 0.045 45);
        --primary: oklch(0.6 0.19 38);
        --primary-foreground: oklch(0.99 0.008 78);
        --secondary: oklch(0.94 0.035 78);
        --secondary-foreground: oklch(0.35 0.06 45);
        --muted: oklch(0.945 0.022 78);
        --muted-foreground: oklch(0.52 0.045 48);
        --accent: oklch(0.9 0.07 70);
        --accent-foreground: oklch(0.35 0.07 45);
        --destructive: oklch(0.55 0.21 25);
        --destructive-foreground: oklch(0.99 0.008 78);
        --border: oklch(0.9 0.025 75);
        --input: oklch(0.9 0.025 75);
        --ring: oklch(0.6 0.19 38);

        --status-pendente: oklch(0.62 0.13 85);
        --status-confirmado: oklch(0.55 0.14 250);
        --status-em-preparo: oklch(0.62 0.16 55);
        --status-saiu: oklch(0.52 0.18 300);
        --status-pronto-retirada: oklch(0.58 0.16 200);
        --status-entregue: oklch(0.55 0.15 150);
        --status-cancelado: oklch(0.55 0.21 25);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          'DM Sans',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          sans-serif;
        background: var(--background);
        color: var(--foreground);
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3 {
        font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        max-width: 100%;
        display: block;
      }

      .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1rem;
      }

      header.topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        border-bottom: 1px solid var(--border);
        background: color-mix(in oklch, var(--background) 90%, transparent);
        backdrop-filter: blur(6px);
      }
      header.topbar .bar {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1rem;
        height: 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        border: none;
        background: none;
        padding: 0;
      }
      .brand .logo {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 999px;
        background: var(--primary);
        color: var(--primary-foreground);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .brand .name {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .topnav {
        display: flex;
        align-items: center;
        gap: 0.15rem;
        flex-wrap: wrap;
      }

      .btn-primary,
      .btn-outline,
      .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        border: none;
        white-space: nowrap;
      }
      .btn-primary {
        background: var(--primary);
        color: var(--primary-foreground);
        padding: 0.6rem 1.3rem;
        transition:
          opacity 0.15s,
          transform 0.15s;
      }
      .btn-primary:hover {
        opacity: 0.9;
      }
      .btn-primary:active {
        transform: scale(0.98);
      }
      .btn-primary:disabled {
        opacity: 0.5;
        pointer-events: none;
      }
      .btn-outline {
        background: var(--card);
        color: var(--foreground);
        border: 1.5px solid var(--border);
        padding: 0.6rem 1.3rem;
        transition: background 0.15s;
      }
      .btn-outline:hover {
        background: var(--secondary);
      }
      .btn-ghost {
        background: transparent;
        color: var(--muted-foreground);
        padding: 0.5rem 0.85rem;
        transition: background 0.15s;
      }
      .btn-ghost:hover {
        background: var(--secondary);
        color: var(--foreground);
      }
      .btn-ghost.icon {
        padding: 0.5rem;
      }
      .btn-danger-text:hover {
        color: var(--destructive);
      }
      button.small {
        padding: 0.35rem 0.55rem;
        font-size: 0.78rem;
      }
      button.circle {
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        border: none;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }
      button.circle:hover {
        background: var(--secondary);
      }
      button.circle:disabled {
        opacity: 0.35;
        pointer-events: none;
      }

      .cart-link {
        position: relative;
      }
      .cart-badge {
        position: absolute;
        top: -0.15rem;
        right: -0.15rem;
        min-width: 1.2rem;
        height: 1.2rem;
        border-radius: 999px;
        background: var(--primary);
        color: var(--primary-foreground);
        font-size: 0.65rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.25rem;
      }

      main.page {
        min-height: calc(100vh - 4rem);
      }
      .tab {
        display: none;
      }
      .tab.active {
        display: block;
      }

      .hero {
        position: relative;
        overflow: hidden;
      }
      .hero img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: linear-gradient(
          to right,
          oklch(0.28 0.045 45 / 80%),
          oklch(0.28 0.045 45 / 45%),
          transparent
        );
      }
      .hero .inner {
        position: relative;
        z-index: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 4rem 1rem 5rem;
      }
      .hero h1 {
        max-width: 32rem;
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--primary-foreground);
        line-height: 1.1;
      }
      .hero p {
        max-width: 26rem;
        margin-top: 0.75rem;
        color: oklch(0.99 0.008 78 / 85%);
      }
      .hero .btn-primary {
        margin-top: 1.5rem;
      }

      section.content {
        padding: 2.5rem 1rem;
      }
      .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        gap: 0.5rem;
      }
      .section-head h2 {
        font-size: 1.5rem;
        font-weight: 700;
      }

      .grid-products {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
      @media (min-width: 640px) {
        .grid-products {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      @media (min-width: 1024px) {
        .grid-products {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .card-surface {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 1rem;
        box-shadow: 0 1px 3px oklch(0.3 0.05 45 / 6%);
      }
      .product-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .product-card .thumb {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--secondary);
      }
      .product-card .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition:
          opacity 0.15s,
          filter 0.15s;
      }
      .product-card .thumb img.out {
        opacity: 0.4;
        filter: grayscale(1);
      }
      .stock-tag {
        position: absolute;
        top: 0.65rem;
        left: 0.65rem;
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        font-size: 0.68rem;
        font-weight: 700;
      }
      .stock-tag.out {
        background: var(--destructive);
        color: var(--destructive-foreground);
      }
      .stock-tag.low {
        background: var(--status-pendente);
        color: var(--primary-foreground);
      }
      .product-card .body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.65rem;
        padding: 0.9rem;
      }
      .product-card h3 {
        font-size: 0.95rem;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
      }
      .product-card .price {
        margin-top: 0.15rem;
        font-family: 'Bricolage Grotesque', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--primary);
      }
      .qty-stepper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 999px;
        border: 1px solid var(--border);
        padding: 0.15rem 0.3rem;
      }
      .qty-stepper span {
        font-size: 0.85rem;
        font-weight: 700;
      }

      .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        padding: 3rem 1.5rem;
        text-align: center;
      }
      .empty-state .muted {
        color: var(--muted-foreground);
        font-size: 0.9rem;
      }
      .skeleton {
        background: var(--muted);
        border-radius: 0.5rem;
        animation: pulse 1.4s ease-in-out infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      label.field-label {
        display: block;
      }
      label.field-label span.lbl {
        display: block;
        margin-bottom: 0.3rem;
        font-size: 0.82rem;
        font-weight: 500;
      }
      label.field-label span.lbl.sm {
        font-size: 0.75rem;
        color: var(--muted-foreground);
        font-weight: 500;
      }
      .input-field,
      select.input-field {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid var(--input);
        background: var(--card);
        padding: 0.6rem 0.85rem;
        font-size: 0.875rem;
        color: var(--foreground);
        font-family: inherit;
      }
      .input-field:focus {
        outline: 2px solid var(--ring);
        outline-offset: 1px;
      }
      .req {
        color: var(--destructive);
      }

      .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.28rem 0.65rem;
        font-size: 0.72rem;
        font-weight: 700;
      }
      .badge-status .dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: currentColor;
      }
      .st-pendente {
        background: color-mix(
          in oklch,
          var(--status-pendente) 15%,
          transparent
        );
        color: var(--status-pendente);
      }
      .st-confirmado {
        background: color-mix(
          in oklch,
          var(--status-confirmado) 15%,
          transparent
        );
        color: var(--status-confirmado);
      }
      .st-em_preparo {
        background: color-mix(
          in oklch,
          var(--status-em-preparo) 15%,
          transparent
        );
        color: var(--status-em-preparo);
      }
      .st-saiu_para_entrega {
        background: color-mix(in oklch, var(--status-saiu) 15%, transparent);
        color: var(--status-saiu);
      }
      .st-pronto_para_retirada {
        background: color-mix(
          in oklch,
          var(--status-pronto-retirada) 15%,
          transparent
        );
        color: var(--status-pronto-retirada);
      }
      .st-entregue {
        background: color-mix(
          in oklch,
          var(--status-entregue) 15%,
          transparent
        );
        color: var(--status-entregue);
      }
      .st-cancelado {
        background: color-mix(
          in oklch,
          var(--status-cancelado) 15%,
          transparent
        );
        color: var(--status-cancelado);
      }
      .st-default {
        background: var(--muted);
        color: var(--muted-foreground);
      }

      .order-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 1rem;
        transition: box-shadow 0.15s;
      }
      .order-card:hover {
        box-shadow: 0 4px 14px oklch(0.3 0.05 45 / 10%);
      }
      .order-card .muted-line {
        margin-top: 0.25rem;
        font-size: 0.85rem;
        color: var(--muted-foreground);
      }
      .order-total {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-weight: 700;
      }

      .filters-card {
        display: grid;
        gap: 0.75rem;
        padding: 1rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 640px) {
        .filters-card.f2 {
          grid-template-columns: repeat(2, 1fr);
        }
        .filters-card.f3 {
          grid-template-columns: repeat(3, 1fr);
        }
        .filters-card.f4 {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .cart-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
      }
      .cart-row img {
        width: 4rem;
        height: 4rem;
        border-radius: 0.75rem;
        object-fit: cover;
        flex-shrink: 0;
      }
      .cart-row .name {
        font-weight: 600;
      }
      .cart-row .unit {
        font-size: 0.85rem;
        color: var(--muted-foreground);
      }
      .cart-row .lineTotal {
        width: 5.5rem;
        text-align: right;
        font-weight: 600;
      }

      .auth-card {
        width: 100%;
        max-width: 24rem;
        padding: 1.5rem;
      }
      .auth-toggle {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--secondary);
        border-radius: 999px;
        padding: 0.25rem;
        margin-bottom: 1.25rem;
      }
      .auth-toggle button {
        border: none;
        background: transparent;
        border-radius: 999px;
        padding: 0.55rem 0;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--muted-foreground);
        cursor: pointer;
      }
      .auth-toggle button.active {
        background: var(--card);
        color: var(--foreground);
        box-shadow: 0 1px 3px oklch(0.3 0.05 45 / 8%);
      }
      .auth-page {
        min-height: calc(100vh - 4rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
        gap: 1rem;
      }

      .timeline {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .timeline li {
        display: flex;
        gap: 0.75rem;
      }
      .timeline .col {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .step-dot {
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
        border-radius: 999px;
        border: 2px solid var(--border);
        background: var(--card);
        color: var(--muted-foreground);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
      }
      .step-dot.done {
        border-color: var(--status-entregue);
        background: var(--status-entregue);
        color: var(--primary-foreground);
      }
      .step-dot.current {
        border-color: var(--primary);
        background: var(--primary);
        color: var(--primary-foreground);
      }
      .step-line {
        width: 2px;
        height: 2rem;
        background: var(--border);
      }
      .step-line.done {
        background: var(--status-entregue);
      }
      .step-body {
        padding-bottom: 1rem;
      }
      .step-body p.step-title {
        font-weight: 600;
      }
      .step-body p.step-title.current {
        color: var(--primary);
      }
      .step-body p.step-title.muted {
        color: var(--muted-foreground);
      }
      .step-body p.step-sub {
        font-size: 0.85rem;
        color: var(--muted-foreground);
      }
      .cancel-banner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        border-radius: 0.75rem;
        background: color-mix(
          in oklch,
          var(--status-cancelado) 10%,
          transparent
        );
        color: var(--status-cancelado);
      }

      table.data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }
      table.data-table th,
      table.data-table td {
        text-align: left;
        padding: 0.65rem 0.9rem;
        vertical-align: middle;
      }
      table.data-table thead th {
        color: var(--muted-foreground);
        font-weight: 600;
        border-bottom: 1px solid var(--border);
      }
      table.data-table tbody tr {
        border-bottom: 1px solid var(--border);
      }
      table.data-table tbody tr:last-child {
        border-bottom: none;
      }
      .table-wrap {
        overflow-x: auto;
      }
      .actions-right {
        display: flex;
        justify-content: flex-end;
        gap: 0.25rem;
      }
      .role-pill {
        border-radius: 999px;
        padding: 0.15rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 700;
      }
      .role-admin {
        background: color-mix(in oklch, var(--primary) 15%, transparent);
        color: var(--primary);
      }
      .role-cliente {
        background: var(--muted);
        color: var(--muted-foreground);
      }

      .admin-subnav {
        display: flex;
        gap: 0.15rem;
        overflow-x: auto;
        background: var(--secondary);
        border-radius: 999px;
        padding: 0.25rem;
        margin-bottom: 1.5rem;
      }
      .admin-subnav button {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border: none;
        background: transparent;
        border-radius: 999px;
        padding: 0.55rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--foreground);
        cursor: pointer;
      }
      .admin-subnav button.active {
        background: var(--card);
        box-shadow: 0 1px 3px oklch(0.3 0.05 45 / 8%);
      }

      .pagenav {
        display: flex;
        gap: 0.15rem;
        overflow-x: auto;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--border);
      }
      .pagenav .wrap {
        display: flex;
        gap: 0.15rem;
      }
      .pagenav button {
        flex-shrink: 0;
        border: 1px solid transparent;
        background: transparent;
        border-radius: 999px;
        padding: 0.5rem 0.9rem;
        font-size: 0.83rem;
        font-weight: 600;
        color: var(--muted-foreground);
        cursor: pointer;
      }
      .pagenav button.active {
        background: var(--secondary);
        color: var(--foreground);
        border-color: var(--border);
      }

      form.stack {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
      .form-card {
        padding: 1.25rem;
        margin-bottom: 1.25rem;
      }
      .form-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }
      .form-head h3 {
        font-size: 1.05rem;
        font-weight: 700;
      }
      .form-grid {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 640px) {
        .form-grid.g2 {
          grid-template-columns: repeat(2, 1fr);
        }
        .form-grid.g3 {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .hint {
        color: var(--muted-foreground);
        font-size: 0.85rem;
      }

      footer.site-footer {
        border-top: 1px solid var(--border);
        padding: 2rem 1rem;
        text-align: center;
        font-size: 0.85rem;
        color: var(--muted-foreground);
      }
      footer.site-footer a {
        text-decoration: underline;
      }

      #toast-area {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
        z-index: 100;
      }
      .toast {
        max-width: 320px;
        padding: 0.7rem 1rem;
        border-radius: 0.75rem;
        font-size: 0.85rem;
        color: #fff;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
      }
      .toast.ok {
        background: var(--status-entregue);
      }
      .toast.err {
        background: var(--destructive);
      }

      .hidden {
        display: none !important;
      }
      .item-row {
        display: grid;
        grid-template-columns: 2fr 1fr auto;
        gap: 0.5rem;
        align-items: end;
        margin-bottom: 0.5rem;
      }
      .icon {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
      }
      .icon.lg {
        width: 2.5rem;
        height: 2.5rem;
      }
      .spin {
        animation: spin 1s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body>

    <header class='topbar'>
      <div class='bar'>
        <button class='brand' data-tab='cardapio'>
          <span class='logo'>
            <svg class='icon' viewBox='0 0 24 24' fill='currentColor'><rect
                x='8'
                y='3'
                width='1.8'
                height='8'
                rx='0.9'
              /><rect x='12.1' y='3' width='1.8' height='8' rx='0.9' /><rect
                x='16.2'
                y='3'
                width='1.8'
                height='8'
                rx='0.9'
              /><rect x='12.1' y='10' width='1.8' height='11' rx='0.9' /></svg>
          </span>
          <span class='name'>Sabor Express</span>
        </button>

        <nav class='topnav'>
          <a
            class='btn-ghost'
            href='/swagger'
            target='_blank'
            rel='noopener'
            title='Documentação da API'
          >
            <svg
              class='icon'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path
                d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'
              /><path d='M14 2v6h6' /><path d='M9 13h6M9 17h6' /></svg>
            Docs API Swagger
          </a>
          <a
            class='btn-ghost'
            href='http://localhost:8025/'
            target='_blank'
            rel='noopener'
            title='Serviço de e-mails (Mailhog)'
          >
            <svg
              class='icon'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path
                d='M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z'
              /><path d='m22 6-10 7L2 6' /></svg>
            E-mails
          </a>
          <a
            class='btn-ghost'
            href='http://localhost:9999/'
            target='_blank'
            rel='noopener'
            title='Logs da aplicação (Dozzle)'
          >
            <svg
              class='icon'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path d='M4 4h16v16H4z' /><path d='M8 8h8M8 12h8M8 16h4' /></svg>
            Logs
          </a>
          <a
            class='btn-ghost auth-only hidden'
            data-tab='meus-pedidos'
            style='align-items:center;'
          >
            <svg
              class='icon'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path
                d='M8 3H6a2 2 0 0 0-2 2v16l4-2 4 2 4-2 4 2V5a2 2 0 0 0-2-2h-2'
              /><path d='M12 3v6M9 6h6' /></svg>
            Meus pedidos
          </a>
          <a class='btn-ghost admin-only hidden' data-tab='admin'>
            <svg
              class='icon'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z' /></svg>
            Admin
          </a>
          <a
            class='btn-ghost cart-link'
            data-tab='carrinho'
            aria-label='Carrinho'
          >
            <svg
              class='icon'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path
                d='M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z'
              /><path d='M3 6h18M16 10a4 4 0 0 1-8 0' /></svg>
            <span class='cart-badge hidden' id='cart-badge'>0</span>
          </a>
          <span id='auth-slot'></span>
        </nav>
      </div>
    </header>

    <main class='page'>

      <!-- CARDÁPIO -->
      <section id='tab-cardapio' class='tab active'>
        <div class='hero'>
          <img
            src='/static/img/hero-food.jpg'
            alt='Prato delicioso do Sabor Express'
          />
          <div class='inner'>
            <h1>Interface para testar a API!</h1>
            <p>Escolha no cardápio, finalize em segundos e acompanhe seu pedido
              em tempo real.</p>
            <a href='#produtos-grid' class='btn-primary'>Ver cardápio</a>
          </div>
        </div>

        <section class='content wrap'>
          <div class='section-head'>
            <h2>Cardápio</h2>
            <div style='display:flex;align-items:center;gap:0.75rem;'>
              <svg
                id='pr-refresh-spin'
                class='icon spin hidden'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              ><path d='M21 12a9 9 0 1 1-2.64-6.36' /><path
                  d='M21 3v6h-6'
                /></svg>
              <a class='btn-primary' data-tab='carrinho'>
                <svg
                  class='icon'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                ><path
                    d='M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z'
                  /><path d='M3 6h18M16 10a4 4 0 0 1-8 0' /></svg>
                Ir ao carrinho e finalizar
              </a>
            </div>
          </div>
          <div id='produtos-grid' class='grid-products'></div>
        </section>
      </section>

      <!-- CARRINHO -->
      <section id='tab-carrinho' class='tab'>
        <div class='content wrap' style='max-width:48rem;'>
          <h1 style='font-size:1.5rem;font-weight:700;'>Seu carrinho</h1>
          <div id='carrinho-body' style='margin-top:1.5rem;'></div>
        </div>
      </section>

      <!-- RASTREAR PEDIDO -->
      <section id='tab-rastrear' class='tab'>
        <div class='content wrap' style='max-width:40rem;'>
          <h1 style='font-size:1.5rem;font-weight:700;'>Rastrear pedido</h1>
          <div class='card-surface' style='padding:1.25rem;margin-top:1rem;'>
            <p style='font-weight:600;'>Acompanhamento por link</p>
            <p class='hint' style='margin-top:0.35rem;'>O rastreio é feito
              apenas pelo link de acompanhamento recebido ao finalizar o pedido
              (ou exibido em "Meus pedidos"). Abra esse link para ver o status
              em tempo real.</p>
          </div>
          <div id='rastrear-result' style='margin-top:1.5rem;'></div>
        </div>
      </section>

      <!-- CONTA (login/registro) -->
      <section id='tab-conta' class='tab'>
        <div class='auth-page'>
          <button
            class='brand'
            data-tab='cardapio'
            style='margin-bottom:0.5rem;'
          >
            <span class='logo'>
              <svg class='icon' viewBox='0 0 24 24' fill='currentColor'><rect
                  x='8'
                  y='3'
                  width='1.8'
                  height='8'
                  rx='0.9'
                /><rect x='12.1' y='3' width='1.8' height='8' rx='0.9' /><rect
                  x='16.2'
                  y='3'
                  width='1.8'
                  height='8'
                  rx='0.9'
                /><rect
                  x='12.1'
                  y='10'
                  width='1.8'
                  height='11'
                  rx='0.9'
                /></svg>
            </span>
            <span class='name'>Sabor Express</span>
          </button>

          <div class='card-surface auth-card' id='conta-deslogado'>
            <div class='auth-toggle'>
              <button
                type='button'
                id='auth-tab-login'
                class='active'
              >Entrar</button>
              <button type='button' id='auth-tab-registro'>Criar conta</button>
            </div>

            <form id='form-login' class='stack'>
              <label class='field-label'>
                <span class='lbl'>E-mail</span>
                <input
                  type='email'
                  id='login-email'
                  class='input-field'
                  required
                  placeholder='voce@email.com'
                />
              </label>
              <label class='field-label'>
                <span class='lbl'>Senha</span>
                <input
                  type='password'
                  id='login-senha'
                  class='input-field'
                  required
                  placeholder='••••••••'
                />
              </label>
              <button
                type='submit'
                class='btn-primary'
                style='width:100%;'
              >Entrar</button>
            </form>

            <form id='form-registro' class='stack hidden'>
              <label class='field-label'>
                <span class='lbl'>Nome</span>
                <input
                  type='text'
                  id='reg-nome'
                  class='input-field'
                  required
                  maxlength='150'
                  placeholder='Seu nome'
                />
              </label>
              <label class='field-label'>
                <span class='lbl'>E-mail</span>
                <input
                  type='email'
                  id='reg-email'
                  class='input-field'
                  required
                  maxlength='150'
                  placeholder='voce@email.com'
                />
              </label>
              <label class='field-label'>
                <span class='lbl'>Senha</span>
                <input
                  type='password'
                  id='reg-senha'
                  class='input-field'
                  required
                  minlength='6'
                  maxlength='255'
                  placeholder='mín. 6 caracteres'
                />
              </label>
              <button
                type='submit'
                class='btn-primary'
                style='width:100%;'
              >Criar conta</button>
            </form>

            <p
              class='hint'
              style='text-align:center;margin-top:1rem;font-size:0.78rem;'
            >
              Você não precisa de conta para fazer pedidos — ela serve para
              acompanhar seu histórico.
            </p>
          </div>

          <div
            class='card-surface auth-card hidden'
            id='conta-logado'
            style='text-align:center;'
          >
            <div id='conta-info'></div>
            <button
              class='btn-outline'
              id='btn-logout'
              style='width:100%;margin-top:1rem;'
            >Sair</button>
          </div>

          <button class='btn-ghost' data-tab='cardapio'>Voltar ao cardápio</button>
        </div>
      </section>

      <!-- MEUS PEDIDOS (autenticado) -->
      <section id='tab-meus-pedidos' class='tab'>
        <div class='content wrap' style='max-width:48rem;'>
          <h1 style='font-size:1.5rem;font-weight:700;'>Meus pedidos</h1>

          <div
            id='mp-logged-out'
            class='empty-state card-surface hidden'
            style='margin-top:1rem;'
          >
            <svg
              class='icon lg'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path
                d='M8 3H6a2 2 0 0 0-2 2v16l4-2 4 2 4-2 4 2V5a2 2 0 0 0-2-2h-2'
              /></svg>
            <p style='font-weight:600;'>Meus pedidos</p>
            <p class='muted'>Entre na sua conta para ver o histórico e
              acompanhar seus pedidos.</p>
            <button class='btn-primary' data-tab='conta'>Entrar ou criar conta</button>
          </div>

          <div id='mp-logged-in' class='hidden'>
            <form
              id='form-meus-pedidos'
              class='card-surface filters-card f3'
              style='margin-top:1rem;'
            >
              <label class='field-label'>
                <span class='lbl sm'>Status</span>
                <select id='mp-status' class='input-field'><option
                    value=''
                  >Todos</option></select>
              </label>
              <label class='field-label'>
                <span class='lbl sm'>De</span>
                <input type='date' id='mp-data-inicio' class='input-field' />
              </label>
              <label class='field-label'>
                <span class='lbl sm'>Até</span>
                <input type='date' id='mp-data-fim' class='input-field' />
              </label>
            </form>
            <div
              id='mp-result'
              style='margin-top:1.25rem;display:flex;flex-direction:column;gap:0.75rem;'
            ></div>
          </div>
        </div>
      </section>

      <!-- ADMIN -->
      <section id='tab-admin' class='tab'>
        <div class='content wrap'>
          <div id='admin-guard' class='empty-state card-surface hidden'>
            <svg
              class='icon lg'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'
              stroke-linejoin='round'
            ><path
                d='M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z'
              /></svg>
            <p style='font-weight:600;' id='admin-guard-title'>Área
              administrativa</p>
            <p class='muted' id='admin-guard-text'>Entre com uma conta de
              administrador.</p>
            <button
              class='btn-primary'
              data-tab='conta'
              id='admin-guard-btn'
            >Entrar</button>
          </div>

          <div id='admin-body' class='hidden'>
            <div class='admin-subnav'>
              <button data-admin-tab='pedidos' class='active'>Pedidos</button>
              <button data-admin-tab='produtos'>Produtos</button>
              <button data-admin-tab='clientes'>Clientes</button>
            </div>

            <!-- Admin > Pedidos -->
            <div id='admin-pedidos' class='admin-tab'>
              <div class='section-head'>
                <h2>Pedidos</h2>
                <span
                  class='hint'
                  style='display:flex;align-items:center;gap:0.4rem;'
                >
                  <svg
                    class='icon'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='2'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    style='color:var(--status-entregue);'
                  ><path
                      d='M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01'
                    /></svg>
                  Tempo real ativo
                </span>
              </div>
              <form
                id='form-todos-pedidos'
                class='card-surface filters-card f4'
                style='margin-bottom:1.25rem;'
              >
                <label class='field-label'>
                  <span class='lbl sm'>Status</span>
                  <select id='tp-status' class='input-field'><option
                      value=''
                    >Todos</option></select>
                </label>
                <label class='field-label'>
                  <span class='lbl sm'>Cliente</span>
                  <select id='tp-cliente-id' class='input-field'><option
                      value=''
                    >Todos</option></select>
                </label>
                <label class='field-label'>
                  <span class='lbl sm'>De</span>
                  <input type='date' id='tp-data-inicio' class='input-field' />
                </label>
                <label class='field-label'>
                  <span class='lbl sm'>Até</span>
                  <input type='date' id='tp-data-fim' class='input-field' />
                </label>
              </form>
              <div
                id='tp-result'
                style='display:flex;flex-direction:column;gap:0.75rem;'
              ></div>
            </div>

            <!-- Admin > Produtos -->
            <div id='admin-produtos' class='admin-tab hidden'>
              <div class='section-head'>
                <h2>Produtos</h2>
                <button class='btn-primary' id='pr-open-create'>
                  <svg
                    class='icon'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='2'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  ><path d='M5 12h14M12 5v14' /></svg>
                  Novo produto
                </button>
              </div>

              <form id='form-produto' class='card-surface form-card hidden'>
                <div class='form-head'>
                  <h3 id='pr-form-title'>Novo produto</h3>
                  <button
                    type='button'
                    class='btn-ghost icon'
                    id='pr-form-close'
                  >
                    <svg
                      class='icon'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                    ><path d='M18 6 6 18M6 6l12 12' /></svg>
                  </button>
                </div>
                <input type='hidden' id='pr-edit-id' />
                <div class='form-grid g3'>
                  <label class='field-label'>
                    <span class='lbl'>Nome</span>
                    <input
                      type='text'
                      id='pr-nome'
                      class='input-field'
                      required
                      maxlength='150'
                      placeholder='Ex.: X-Burger da casa'
                    />
                  </label>
                  <label class='field-label'>
                    <span class='lbl'>Preço (R$)</span>
                    <input
                      type='number'
                      id='pr-preco'
                      class='input-field'
                      required
                      min='0.01'
                      step='0.01'
                      placeholder='29.90'
                    />
                  </label>
                  <label class='field-label'>
                    <span class='lbl'>Estoque</span>
                    <input
                      type='number'
                      id='pr-estoque'
                      class='input-field'
                      required
                      min='0'
                      value='0'
                    />
                  </label>
                </div>
                <div class='form-actions'>
                  <button
                    type='button'
                    class='btn-outline'
                    id='pr-form-cancel'
                  >Cancelar</button>
                  <button type='submit' class='btn-primary'>Salvar</button>
                </div>
              </form>

              <div id='pr-result'></div>
            </div>

            <!-- Admin > Clientes -->
            <div id='admin-clientes' class='admin-tab hidden'>
              <div class='section-head'>
                <h2>Clientes</h2>
                <button class='btn-primary' id='cl-open-create'>
                  <svg
                    class='icon'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='2'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                  ><path d='M5 12h14M12 5v14' /></svg>
                  Novo cliente
                </button>
              </div>

              <form id='form-cliente' class='card-surface form-card hidden'>
                <div class='form-head'>
                  <h3 id='cl-form-title'>Novo cliente</h3>
                  <button
                    type='button'
                    class='btn-ghost icon'
                    id='cl-form-close'
                  >
                    <svg
                      class='icon'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                    ><path d='M18 6 6 18M6 6l12 12' /></svg>
                  </button>
                </div>
                <input type='hidden' id='cl-edit-id' />
                <div class='form-grid g3'>
                  <label class='field-label'>
                    <span class='lbl'>Nome</span>
                    <input
                      type='text'
                      id='cl-nome'
                      class='input-field'
                      required
                      maxlength='150'
                      placeholder='Nome do cliente'
                    />
                  </label>
                  <label class='field-label'>
                    <span class='lbl'>E-mail</span>
                    <input
                      type='email'
                      id='cl-email'
                      class='input-field'
                      required
                      maxlength='150'
                      placeholder='cliente@email.com'
                    />
                  </label>
                  <label class='field-label'>
                    <span class='lbl' id='cl-senha-label'>Senha (opcional)</span>
                    <input
                      type='password'
                      id='cl-senha'
                      class='input-field'
                      minlength='6'
                      maxlength='255'
                      placeholder='••••••••'
                    />
                  </label>
                </div>
                <div class='form-actions'>
                  <button
                    type='button'
                    class='btn-outline'
                    id='cl-form-cancel'
                  >Cancelar</button>
                  <button type='submit' class='btn-primary'>Salvar</button>
                </div>
              </form>

              <div id='cl-result'></div>
            </div>
          </div>
        </div>
      </section>

    </main>

    <footer class='site-footer'>
      Sabor Express · Delivery com acompanhamento em tempo real ·
      <a href='#' data-tab='conta'>Entrar / Criar conta</a>
    </footer>

    <div id='toast-area'></div>

    <script src='/socket.io/socket.io.js'></script>
    <script src='/static/js/app.js'></script>

  </body>
</html>